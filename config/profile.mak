# This is the supported browser/Node profile, shared by all three PHP versions.
# Architecture and PHP version are selected by scripts/build.sh.
LIB_TYPE=dynamic
WITH_SOURCEMAPS=0
ASSERTIONS=1
OPTIMIZE=3
SYMBOLS=0
GZIP=0
BROTLI=0
ASYNCIFY=1
INITIAL_MEMORY=128MB
MAXIMUM_MEMORY=4096MB

WITH_VRZNO=1
WITH_WAITLINE=0
WITH_PDO_PGLITE=0
WITH_PDO_CFD1=0
WITH_SDL=0
WITH_YAML=0
WITH_TIDY=0

WITH_BCMATH=1
WITH_CALENDAR=1
WITH_CTYPE=1
WITH_EXIF=1
WITH_FILTER=1
WITH_SESSION=1
WITH_TOKENIZER=1
CONFIGURE_FLAGS+= --enable-fileinfo

WITH_ZLIB=dynamic
WITH_LIBXML=dynamic
WITH_XML=dynamic
WITH_DOM=dynamic
WITH_SIMPLEXML=dynamic
WITH_XMLREADER=dynamic
WITH_XMLWRITER=dynamic
WITH_ICONV=dynamic
WITH_MBSTRING=dynamic
WITH_ONIGURUMA=dynamic
WITH_INTL=dynamic
WITH_LIBZIP=dynamic
WITH_GD=dynamic
WITH_LIBPNG=shared
WITH_LIBJPEG=shared
WITH_FREETYPE=shared
WITH_LIBWEBP=shared
WITH_OPENSSL=dynamic
WITH_PHAR=dynamic
WITH_SQLITE=dynamic
