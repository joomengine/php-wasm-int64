 #!/usr/bin/env node
-import { PhpNode } from 'php-wasm/PhpNode.mjs';
 import fs from 'node:fs';
+import { resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
 
-const [version, envName] = process.argv.slice(2);
+const [version, envName, runtimePath] = process.argv.slice(2);
+// Build from the local distribution, without requiring npm workspace symlinks.
+const runtimeURL = runtimePath
+    ? pathToFileURL(resolve(runtimePath))
+    : new URL('../packages/php-wasm/PhpNode.mjs', import.meta.url);
+const { PhpNode } = await import(runtimeURL);
 const php = new PhpNode({ version, envName });
+let output = '', diagnostics = '';
+php.addEventListener('output', event => { output += event.detail.join(''); });
+php.addEventListener('error', event => { diagnostics += event.detail.join(''); });
 
-php.addEventListener('output', event => console.log(event.detail.map(line => line.replace(/\s+$/, '')).join('')));
-php.addEventListener('error', event => console.log(event.detail.map(line => line.replace(/\s+$/, '')).join('')));
-
-php.run( fs.readFileSync('demo-node/persist/symbols.php') );
+const status = await php.run(fs.readFileSync(new URL('./persist/symbols.php', import.meta.url), 'utf8'));
+await php.flush();
+if (status !== 0 || diagnostics) {
+    throw new Error('PHP ' + version + ' symbol generation failed (status ' + status + '): ' + diagnostics);
+}
+// Flush generated source before terminating this single-use runtime process.
+await new Promise((accept, reject) => process.stdout.write(output, error => error ? reject(error) : accept()));
+process.exit(0);
