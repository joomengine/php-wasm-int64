diff --git a/source/pib/mail.c b/source/pib/mail.c
new file mode 100644
index 00000000..40da2ef2
--- /dev/null
+++ b/source/pib/mail.c
@@ -0,0 +1,216 @@
+/* Browser-local Sendmail transport. No operating-system process is created. */
+#define _GNU_SOURCE
+#include <emscripten.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "mail.h"
+
+typedef struct pib_mail_pipe {
+	FILE *stream;
+	char *bytes;
+	size_t size;
+	char *command;
+	char *tokens;
+	char **args;
+	size_t count;
+	const char *sender;
+	char **recipients;
+	size_t recipient_count;
+	int headers;
+	int abandoned;
+	struct pib_mail_pipe *next;
+} pib_mail_pipe;
+
+static pib_mail_pipe *pib_mail_pipes;
+
+/* A copied byte array remains valid while Asyncify is suspended or memory grows.
+ * All metadata is copied before awaiting host acceptance. A missing, throwing,
+ * or rejecting handler must never be reported as a successful capture. */
+EM_ASYNC_JS(int, pib_mail_accept, (const unsigned char *bytes, size_t size,
+	const char *command, size_t count, char **args, const char *sender,
+	size_t recipient_count, char **recipients, int headers), {
+	try {
+		const handler = Module.joomengineMailCapture;
+		if (typeof handler !== 'function') return 0;
+		const strings = (pointer, length) => Array.from({length}, (_, index) =>
+			UTF8ToString(HEAPU32[(pointer >>> 2) + index]));
+		const message = {
+			version: 1,
+			raw: HEAPU8.slice(bytes >>> 0, (bytes >>> 0) + (size >>> 0)),
+			command: UTF8ToString(command),
+			args: strings(args, count),
+			envelopeSender: sender ? UTF8ToString(sender) : null,
+			envelopeRecipients: strings(recipients, recipient_count),
+			readRecipientsFromHeaders: !!headers
+		};
+		return (await handler(message)) === true ? 1 : 0;
+	} catch (error) {
+		return 0;
+	}
+});
+
+int EMSCRIPTEN_KEEPALIVE pib_mail_capture_version(void)
+{
+	return 1;
+}
+
+static void pib_mail_free(pib_mail_pipe *pipe)
+{
+	free(pipe->bytes);
+	free(pipe->command);
+	free(pipe->tokens);
+	free(pipe->args);
+	free(pipe->recipients);
+	free(pipe);
+}
+
+/* Parse only literal shell quoting needed by PHP/PHPMailer. Expansions,
+ * redirections, command separators, and line continuations are unsupported.
+ * The resulting arguments never reach a shell or any external executable. */
+static int pib_mail_parse(pib_mail_pipe *pipe, const char *command)
+{
+	size_t length = strlen(command);
+	if (length > (SIZE_MAX / sizeof(char *)) - 2) return 0;
+	pipe->command = strdup(command);
+	pipe->tokens = malloc(length + 1);
+	pipe->args = calloc(length + 2, sizeof(char *));
+	pipe->recipients = calloc(length + 2, sizeof(char *));
+	if (!pipe->command || !pipe->tokens || !pipe->args || !pipe->recipients) {
+		errno = ENOMEM;
+		return 0;
+	}
+
+	const unsigned char *read = (const unsigned char *) command;
+	char *write = pipe->tokens;
+	while (*read) {
+		while (*read == ' ' || *read == '\t') read++;
+		if (!*read) break;
+		pipe->args[pipe->count++] = write;
+		unsigned char quote = 0;
+		while (*read) {
+			unsigned char c = *read++;
+			if (c < 32 || c == 127) {
+				if (!quote && c == '\t') break;
+				return 0;
+			}
+			if (!quote && c == ' ') break;
+			if (c == quote) {
+				quote = 0;
+				continue;
+			}
+			if (!quote && (c == '\'' || c == '"')) {
+				quote = c;
+				continue;
+			}
+			if (c == '\\' && quote != '\'') {
+				unsigned char escaped = *read++;
+				if (escaped < 32 || escaped == 127) return 0;
+				/* Within double quotes a backslash only quotes these characters. */
+				if (quote == '"' && !strchr("\\\"$`", escaped)) *write++ = '\\';
+				*write++ = (char) escaped;
+				continue;
+			}
+			if ((!quote && strchr("|&;<>()$`*?[]{}~", c))
+				|| (quote == '"' && (c == '$' || c == '`'))) return 0;
+			*write++ = (char) c;
+		}
+		if (quote) return 0;
+		*write++ = '\0';
+	}
+	if (!pipe->count || strcmp(pipe->args[0], "/usr/sbin/sendmail")) return 0;
+
+	int positional = 0;
+	for (size_t index = 1; index < pipe->count; index++) {
+		char *arg = pipe->args[index];
+		if (!*arg) return 0;
+		if (!positional && !strcmp(arg, "--")) {
+			positional = 1;
+		} else if (!positional && !strcmp(arg, "-t")) {
+			pipe->headers = 1;
+		} else if (!positional && (!strcmp(arg, "-i") || !strcmp(arg, "-oi"))) {
+			/* Dot lines remain part of the original message bytes. */
+		} else if (!positional && !strncmp(arg, "-f", 2)) {
+			if (pipe->sender) return 0;
+			if (arg[2]) pipe->sender = arg + 2;
+			else if (++index < pipe->count) pipe->sender = pipe->args[index];
+			else return 0;
+			if (!*pipe->sender || pipe->sender[0] == '-') return 0;
+		} else {
+			if (arg[0] == '-') return 0;
+			pipe->recipients[pipe->recipient_count++] = arg;
+		}
+	}
+	return 1;
+}
+
+/* Strong definitions replace Emscripten's ENOSYS stubs, never its shell layer. */
+FILE *popen(const char *command, const char *mode)
+{
+	if (!command || !mode || (strcmp(mode, "w") && strcmp(mode, "wb"))) {
+		errno = ENOSYS;
+		return NULL;
+	}
+	pib_mail_pipe *pipe = calloc(1, sizeof(*pipe));
+	if (!pipe) return NULL;
+	errno = ENOSYS;
+	if (!pib_mail_parse(pipe, command)) {
+		int error = errno;
+		pib_mail_free(pipe);
+		errno = error;
+		return NULL;
+	}
+	pipe->stream = open_memstream(&pipe->bytes, &pipe->size);
+	if (!pipe->stream) {
+		int error = errno;
+		pib_mail_free(pipe);
+		errno = error;
+		return NULL;
+	}
+	pipe->next = pib_mail_pipes;
+	pib_mail_pipes = pipe;
+	return pipe->stream;
+}
+
+int pclose(FILE *stream)
+{
+	pib_mail_pipe **entry = &pib_mail_pipes;
+	while (*entry && (*entry)->stream != stream) entry = &(*entry)->next;
+	if (!*entry) {
+		errno = ENOSYS;
+		return -1;
+	}
+	pib_mail_pipe *pipe = *entry;
+	*entry = pipe->next; /* Remove before Asyncify can suspend: finalize once. */
+	int failed = ferror(stream);
+	if (fflush(stream)) failed = 1;
+	if (fclose(stream)) failed = 1;
+	int accepted = !failed && !pipe->abandoned && pib_mail_accept(
+		(const unsigned char *) pipe->bytes, pipe->size, pipe->command,
+		pipe->count - 1, pipe->args + 1, pipe->sender,
+		pipe->recipient_count, pipe->recipients, pipe->headers);
+	pib_mail_free(pipe);
+	/* pclose returns waitpid's encoded status; PHP unwraps WEXITSTATUS. */
+	if (!accepted) errno = EIO;
+	return accepted ? 0 : (1 << 8);
+}
+
+void pib_mail_abandon(void)
+{
+	for (pib_mail_pipe *pipe = pib_mail_pipes; pipe; pipe = pipe->next) {
+		pipe->abandoned = 1;
+	}
+}
+
+/* Internal request-boundary cleanup: PHP must have destroyed its streams first. */
+void EMSCRIPTEN_KEEPALIVE pib_mail_discard(void)
+{
+	while (pib_mail_pipes) {
+		pib_mail_pipe *pipe = pib_mail_pipes;
+		pib_mail_pipes = pipe->next;
+		fclose(pipe->stream);
+		pib_mail_free(pipe);
+	}
+}
