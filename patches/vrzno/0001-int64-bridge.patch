+/**
+ * Reads PHP-generated JSON without first rounding integer tokens through Number.
+ * PHP emits integral floats with a fractional suffix for this transport, so only
+ * native integer values outside the JavaScript safe range become BigInt.
+ *
+ * @param {string} source JSON produced by php_json_encode_zval().
+ * @returns {*} Detached JSON values with exact integer tokens.
+ */
+Module.vrznoParseJson = source => {
+	let offset = 0;
+	const whitespace = () => {
+		while(offset < source.length && [32, 9, 10, 13].includes(source.charCodeAt(offset))) offset++;
+	};
+	const fail = () => { throw new SyntaxError(`Invalid PHP bridge JSON at offset ${offset}`); };
+	const string = () => {
+		const start = offset++;
+		while(offset < source.length)
+		{
+			// Emscripten's metadata extractor unescapes doubled backslashes after
+			// EM_JS stringification. Character codes survive both compiler stages.
+			const character = source.charCodeAt(offset++);
+			if(character === 34) return JSON.parse(source.slice(start, offset));
+			if(character === 92) offset++;
+		}
+		return fail();
+	};
+	const value = (depth = 0) => {
+		if(depth > 512) return fail();
+		whitespace();
+		const character = source[offset];
+		if(character === '"') return string();
+		if(character === '[' || character === '{')
+		{
+			const array = character === '[';
+			const result = array ? [] : {};
+			const closing = array ? ']' : '}';
+			offset++;
+			whitespace();
+			if(source[offset] === closing) { offset++; return result; }
+			while(offset < source.length)
+			{
+				let key;
+				if(!array)
+				{
+					whitespace();
+					if(source[offset] !== '"') return fail();
+					key = string();
+					whitespace();
+					if(source[offset++] !== ':') return fail();
+				}
+				const entry = value(depth + 1);
+				if(array) result.push(entry);
+				else Object.defineProperty(result, key, {value: entry, enumerable: true, configurable: true, writable: true});
+				whitespace();
+				const next = source[offset++];
+				if(next === closing) return result;
+				if(next !== ',') return fail();
+			}
+			return fail();
+		}
+		for(const [literal, result] of [['true', true], ['false', false], ['null', null]])
+		{
+			if(source.startsWith(literal, offset)) { offset += literal.length; return result; }
+		}
+		const match = /^-?(?:0|[1-9][0-9]*)(?:[.][0-9]+)?(?:[eE][+-]?[0-9]+)?/.exec(source.slice(offset));
+		if(!match) return fail();
+		const token = match[0];
+		offset += token.length;
+		if(!/[.eE]/.test(token))
+		{
+			const integer = BigInt(token);
+			if(integer < -9007199254740991n || integer > 9007199254740991n) return integer;
+		}
+		return Number(token);
+	};
+	const result = value();
+	whitespace();
+	if(offset !== source.length) return fail();
+	return result;
+};
